# ---- ROMs: never commit -------------------------------------------------
*.gb
*.gbc
*.sgb

# Save files
*.sav
*.srm
*.sav.bak*
*.state

# ---- Build output: all regenerable --------------------------------------
build/

# ---- Extracted script: regenerable AND derived from the game ------------
